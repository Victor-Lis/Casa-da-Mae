model Conteudo {
  id          BigInt   @id @default(autoincrement())
  editedAt    DateTime @map("edited_at") @db.Timestamptz(6)
  descricao   String   @db.Text
  link        String   @db.Text
  curso       String
  titulo      String
  tipo        String
  isFavorite  Boolean  @map("is_favorite")
  tipoDeMidia TipoDeMidia   @map("tipo_de_midia")

  @@map("conteudos")
}
